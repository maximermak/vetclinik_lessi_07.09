# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...

# ID чату/групи, куди бот надсилає заявки.
# Дізнатись: напишіть боту будь-яке повідомлення і виконайте `npm run chat-id`
TELEGRAM_CHAT_ID=

PORT=3000

# Ключ Google Maps (Places API New). Рейтинг у шапці сайту показуємо
# ЛИШЕ живий: без цього ключа блок з оцінкою просто не виводиться,
# замість нього стоїть посилання на відгуки. З ключем цифри
# оновлюються самі, двічі на добу.
GOOGLE_MAPS_API_KEY=

# Google Analytics 4. Без цієї змінної скрипт аналітики не підключається
# взагалі — саме тому локальна розробка не псує статистику клієнта.
GA_MEASUREMENT_ID=

# Публічна адреса сайту — потрібна для прев'ю посилань
# у Telegram/соцмережах (og:image має бути абсолютним)
SITE_URL=
