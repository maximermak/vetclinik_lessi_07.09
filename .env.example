# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...

# ID чату/групи, куди бот надсилає заявки.
# Дізнатись: напишіть боту будь-яке повідомлення і виконайте `npm run chat-id`
TELEGRAM_CHAT_ID=

PORT=3000

# Необов'язково: ключ Google Maps (Places API New) —
# з ним рейтинг і кількість відгуків оновлюються самі, двічі на добу
GOOGLE_MAPS_API_KEY=

# Публічна адреса сайту — потрібна для прев'ю посилань
# у Telegram/соцмережах (og:image має бути абсолютним)
SITE_URL=
