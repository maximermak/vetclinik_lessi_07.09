<!doctype html>
<html lang="uk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= clinic.name %> — ветеринарна клініка та грумінг-салон у <%= clinic.cityIn %></title>
<meta name="description" content="Ветклініка Pussy Cat у Харкові, вул. Олександра Олеся, 21: вакцинація, хірургія, стоматологія, дерматологія, лабораторна діагностика та грумінг-салон. Запис онлайн.">
<link rel="canonical" href="<%= siteUrl %>/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= clinic.name %>">
<meta property="og:locale" content="uk_UA">
<meta property="og:url" content="<%= siteUrl %>/">
<meta property="og:title" content="<%= clinic.name %> — ветклініка та грумінг у <%= clinic.cityIn %>">
<meta property="og:description" content="Вакцинація, хірургія, стоматологія, дерматологія та грумінг-салон у <%= clinic.cityIn %>, <%= clinic.address %>. Запис онлайн за хвилину.">
<meta property="og:image" content="<%= siteUrl %>/img/og.jpg?v=<%= v('/img/og.jpg') %>">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Ветеринарна клініка Pussy Cat — турбота про тих, хто вас безумовно любить">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= clinic.name %> — ветклініка та грумінг у <%= clinic.cityIn %>">
<meta name="twitter:description" content="Вакцинація, хірургія, стоматологія та грумінг-салон. Запис онлайн за хвилину.">
<meta name="twitter:image" content="<%= siteUrl %>/img/og.jpg?v=<%= v('/img/og.jpg') %>">
<meta name="theme-color" content="#b0331f">
<link rel="icon" href="/img/favicon.svg?v=<%= v('/img/favicon.svg') %>" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css?v=<%= v('/css/style.css') %>">
<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'VeterinaryCare',
  name: clinic.name,
  description: clinic.tagline + ' у ' + clinic.cityIn,
  address: {
    '@type': 'PostalAddress',
    streetAddress: clinic.address,
    addressLocality: clinic.city,
    postalCode: '61000',
    addressCountry: 'UA'
  },
  telephone: clinic.phones.map(function (p) { return p.raw; }),
  openingHoursSpecification: clinic.schedule.map(function (s) {
    return { '@type': 'OpeningHoursSpecification', dayOfWeek: s.dayOfWeek, opens: s.opens, closes: s.closes };
  }),
  sameAs: [clinic.googleReviewsUrl],
  availableService: services.map(function (s) { return { '@type': 'MedicalProcedure', name: s.title }; })
}) %>
</script>
</head>
<body>
<%- include('partials/icons') %>
<%- include('partials/header', { clinic: clinic }) %>

<main>
  <!-- ══ HERO ══ -->
  <section class="hero">
    <div class="hero__paws" aria-hidden="true"></div>
    <div class="container hero__in">
      <div class="hero__text reveal">
        <span class="eyebrow"><svg viewBox="0 0 24 24" class="icon icon--sm icon--fill" aria-hidden="true"><use href="#i-paw"/></svg> Ветклініка та грумінг у <%= clinic.cityIn %></span>
        <h1>Турбота про тих,<br>хто вас <span class="hl">безумовно любить</span></h1>
        <p class="hero__lead">
          Повний спектр ветеринарних послуг і грумінг-салон під одним дахом.
          Приймаємо котів, собак і дрібних улюбленців — від планового щеплення до складної операції.
        </p>

        <div class="hero__cta">
          <a class="btn btn--primary" href="#booking" data-modal-open>Записатись на прийом</a>
          <a class="btn btn--ghost" href="tel:<%= clinic.phones[0].raw %>">
            <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-phone"/></svg>
            Зателефонувати
          </a>
        </div>

        <div class="hero__trust">
          <a class="rating" href="<%= clinic.googleReviewsUrl %>" target="_blank" rel="noopener">
            <% var ratingParts = String(clinic.rating).split(','); %>
            <span class="rating__score"><%= ratingParts[0] %><% if (ratingParts.length > 1) { %><span class="rating__sep">,</span><%= ratingParts[1] %><% } %></span>
            <span class="rating__body">
              <span class="stars" aria-hidden="true">★★★★★</span>
              <span class="rating__label"><%= clinic.reviewsCount %> <%= plural(clinic.reviewsCount, 'відгук', 'відгуки', 'відгуків') %> у Google Maps</span>
            </span>
          </a>
          <span class="hero__stat"><b>10+</b> років практики</span>
        </div>
      </div>

      <aside class="hero__card reveal">
        <div class="hcard">
          <div class="hcard__head">
            <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-clock"/></svg>
            <h2>Графік роботи</h2>
          </div>
          <ul class="hcard__hours">
            <% clinic.schedule.forEach(function (s) { %>
              <li><span><%= s.days %></span><b><%= s.hours %></b></li>
            <% }) %>
          </ul>
          <div class="hcard__phones">
            <% clinic.phones.forEach(function (p) { %>
              <a href="tel:<%= p.raw %>">
                <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-phone"/></svg>
                <%= p.pretty %>
              </a>
            <% }) %>
          </div>
          <p class="hcard__note">Гострі стани приймаємо без запису — попередьте нас дзвінком, і лікар буде готовий.</p>
        </div>
      </aside>
    </div>
  </section>

  <!-- ══ ПЕРЕВАГИ-СТРІЧКА ══ -->
  <section class="strip">
    <div class="container strip__in">
      <div class="strip__item reveal"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-stethoscope"/></svg><span>Досвідчені лікарі<br><small>терапія, хірургія, дерматологія</small></span></div>
      <div class="strip__item reveal"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-flask"/></svg><span>Своя лабораторія<br><small>аналізи в день звернення</small></span></div>
      <div class="strip__item reveal"><svg viewBox="0 0 24 24" class="icon icon--fill" aria-hidden="true"><use href="#i-paw"/></svg><span>Грумінг-салон<br><small>стрижка котів і собак</small></span></div>
      <div class="strip__item reveal"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-shield"/></svg><span>Чесні ціни<br><small>вартість — до початку прийому</small></span></div>
    </div>
  </section>

  <!-- ══ ПОСЛУГИ ══ -->
  <section class="section" id="services">
    <div class="container">
      <header class="section__head reveal">
        <span class="eyebrow">Наші послуги</span>
        <h2>Усе для здоров’я улюбленця<br>в одній клініці</h2>
        <p>Не потрібно возити тварину містом: діагностика, лікування та догляд — на одній адресі.</p>
      </header>

      <div class="services">
        <% services.forEach(function (s) { %>
          <a class="srv reveal" href="#booking" data-modal-open data-service="<%= s.title %>">
            <span class="srv__icon">
              <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-<%= s.icon %>"/></svg>
            </span>
            <span class="srv__body">
              <span class="srv__title"><%= s.title %></span>
              <span class="srv__text"><%= s.text %></span>
            </span>
            <svg viewBox="0 0 24 24" class="icon icon--sm srv__go" aria-hidden="true"><use href="#i-chev"/></svg>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ══ ГРУМІНГ ══ -->
  <section class="grooming" id="grooming">
    <div class="container">
      <div class="grooming__head reveal">
        <div class="grooming__intro">
          <span class="eyebrow eyebrow--light">Грумінг-салон</span>
          <h2>Грумінг без стресу —<br>для вас і для улюбленця</h2>
          <p>
            Підбираємо темп під характер тварини. Якщо під час стрижки
            щось насторожує — поруч завжди лікар клініки.
          </p>
        </div>

        <div class="grooming__photos">
          <img class="gphoto gphoto--main"
               src="/img/photos/cat-blanket.jpg?v=<%= v('/img/photos/cat-blanket.jpg') %>"
               width="540" height="720" loading="lazy" decoding="async"
               alt="Кіт спокійно лежить, загорнутий у плед, на столі в клініці Pussy Cat">
          <img class="gphoto gphoto--accent"
               src="/img/photos/cat-calm.jpg?v=<%= v('/img/photos/cat-calm.jpg') %>"
               width="312" height="228" loading="lazy" decoding="async"
               alt="Чорно-білий кіт на прийомі в ветклініці Pussy Cat">
        </div>
      </div>

      <div class="grid grid--groom">
        <% grooming.forEach(function (g) { %>
          <article class="gcard reveal">
            <span class="gcard__icon">
              <svg viewBox="0 0 24 24" class="icon<%= g.icon === 'paw' ? ' icon--fill' : '' %>" aria-hidden="true"><use href="#i-<%= g.icon %>"/></svg>
            </span>
            <h3><%= g.title %></h3>
            <p><%= g.text %></p>
          </article>
        <% }) %>
      </div>

      <div class="grooming__cta reveal">
        <a class="btn btn--yellow" href="#booking" data-modal-open data-service="Грумінг / стрижка">
          Записатись на грумінг
        </a>
        <span>або зателефонуйте: <a href="tel:<%= clinic.phones[0].raw %>"><%= clinic.phones[0].pretty %></a></span>
      </div>
    </div>
  </section>

  <!-- ══ ЧОМУ МИ ══ -->
  <section class="section section--cream" id="why">
    <div class="container">
      <header class="section__head reveal">
        <span class="eyebrow">Чому нас обирають</span>
        <h2>Клініка, куди повертаються</h2>
        <p>Нас знаходять за відгуками друзів — і залишаються надовго.</p>
      </header>

      <div class="grid grid--why">
        <% advantages.forEach(function (a, i) { %>
          <article class="why reveal">
            <span class="why__num"><%= String(i + 1).padStart(2, '0') %></span>
            <h3><%= a.title %></h3>
            <p><%= a.text %></p>
          </article>
        <% }) %>
      </div>

      <div class="brands reveal">
        <span class="brands__label">У клініці можна одразу купити корм</span>
        <div class="brands__row">
          <a class="brand-card" href="#booking" data-modal-open data-service="Консультація або інше" aria-label="Josera">
            <img class="brand-card__logo brand-card__logo--josera" src="/img/josera.png?v=<%= v('/img/josera.png') %>"
                 width="800" height="178" loading="lazy" alt="Josera">
          </a>
          <a class="brand-card" href="#booking" data-modal-open data-service="Консультація або інше" aria-label="1st Choice">
            <img class="brand-card__logo brand-card__logo--choice" src="/img/1st-choice.png?v=<%= v('/img/1st-choice.png') %>"
                 width="863" height="575" loading="lazy" alt="1st Choice Nutrition">
          </a>
        </div>
        <span class="brands__note">
          Повсякденні та лікувальні лінійки для котів і собак — лікар допоможе підібрати раціон під вік і діагноз
        </span>
      </div>
    </div>
  </section>

  <!-- ══ ВІДГУКИ ══ -->
  <section class="section" id="reviews">
    <div class="container">
      <header class="section__head reveal">
        <span class="eyebrow">Відгуки</span>
        <h2>Що кажуть власники</h2>
        <p>Кілька відгуків із <a href="<%= clinic.googleReviewsUrl %>" target="_blank" rel="noopener">нашої сторінки в Google Maps</a>.</p>
      </header>

      <div class="grid grid--reviews">
        <% reviews.forEach(function (r) { %>
          <figure class="review reveal<%= r.full ? ' review--more' : '' %>"
            <% if (r.full) { %>
              data-review
              data-name="<%= r.name %>"
              data-pet="<%= r.pet %>"
              data-full="<%= r.full %>"
              role="button" tabindex="0"
              aria-label="Читати повний відгук: <%= r.name %>"
            <% } %>>
            <div class="review__top">
              <span class="avatar"><%= r.name.charAt(0) %></span>
              <div class="review__who">
                <b><%= r.name %></b>
                <span class="review__meta">
                  <span class="stars" aria-label="5 з 5">★★★★★</span>
                  <span class="review__pet"><%= r.pet %></span>
                </span>
              </div>
            </div>
            <blockquote>«<%= r.text %>»</blockquote>
            <% if (r.full) { %>
              <span class="review__more">
                Читати повністю
                <svg viewBox="0 0 24 24" class="icon icon--sm" aria-hidden="true"><use href="#i-chev"/></svg>
              </span>
            <% } %>
          </figure>
        <% }) %>
      </div>

      <div class="reviews__more reveal">
        <a class="btn btn--ghost" href="<%= clinic.googleReviewsUrl %>" target="_blank" rel="noopener">
          Усі відгуки в Google Maps
        </a>
      </div>
    </div>
  </section>

  <!-- ══ ЗАЯВКА ══ -->
  <section class="booking" id="booking">
    <div class="container booking__in">
      <div class="booking__text reveal">
        <span class="eyebrow eyebrow--light">Онлайн-запис</span>
        <h2>Запишіться<br>за одну хвилину</h2>
        <p>
          Заповніть форму — заявка миттєво прилетить адміністратору в Telegram.
          Ми передзвонимо у робочі години й підберемо зручний час.
        </p>
        <ul class="checks checks--light">
          <li><svg viewBox="0 0 24 24" class="icon icon--sm" aria-hidden="true"><use href="#i-check"/></svg>Передзвонюємо протягом 15 хвилин</li>
          <li><svg viewBox="0 0 24 24" class="icon icon--sm" aria-hidden="true"><use href="#i-check"/></svg>Підкажемо, як підготувати тварину</li>
          <li><svg viewBox="0 0 24 24" class="icon icon--sm" aria-hidden="true"><use href="#i-check"/></svg>Озвучимо вартість заздалегідь</li>
        </ul>
        <div class="booking__phones">
          <% clinic.phones.forEach(function (p) { %>
            <a href="tel:<%= p.raw %>"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-phone"/></svg><%= p.pretty %></a>
          <% }) %>
        </div>
      </div>

      <div class="formwrap reveal">
        <h3 class="form__title">Заявка на прийом</h3>
        <%- include('partials/form', { prefix: 'sec', serviceOptions: serviceOptions, petAgeOptions: petAgeOptions, scheduleByWeekday: scheduleByWeekday }) %>
      </div>
    </div>
  </section>

  <!-- ══ FAQ ══ -->
  <section class="section section--cream" id="faq">
    <div class="container container--narrow">
      <header class="section__head reveal">
        <span class="eyebrow">Часті питання</span>
        <h2>Коротко про головне</h2>
      </header>

      <div class="faq">
        <% faq.forEach(function (f) { %>
          <details class="faq__item reveal">
            <summary><%= f.q %><svg viewBox="0 0 24 24" class="icon icon--sm" aria-hidden="true"><use href="#i-chev"/></svg></summary>
            <div class="faq__body"><p><%= f.a %></p></div>
          </details>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ══ КОНТАКТИ ══ -->
  <section class="section contacts" id="contacts">
    <div class="container">
      <header class="section__head reveal">
        <span class="eyebrow">Контакти</span>
        <h2>Як нас знайти</h2>
      </header>

      <div class="contacts__in">
        <div class="contacts__info reveal">
          <div class="cinfo">
            <span class="cinfo__ic"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-pin"/></svg></span>
            <div>
              <b>Адреса</b>
              <p>
                <%= clinic.addressFull %><br>
                <a href="<%= clinic.googleReviewsUrl %>" target="_blank" rel="noopener">Відкрити в Google Maps</a>
              </p>
            </div>
          </div>
          <div class="cinfo">
            <span class="cinfo__ic"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-phone"/></svg></span>
            <div>
              <b>Телефони</b>
              <p>
                <% clinic.phones.forEach(function (p) { %>
                  <a href="tel:<%= p.raw %>"><%= p.pretty %></a><br>
                <% }) %>
              </p>
            </div>
          </div>
          <div class="cinfo">
            <span class="cinfo__ic"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-clock"/></svg></span>
            <div>
              <b>Графік роботи</b>
              <p>
                <% clinic.schedule.forEach(function (s) { %>
                  <%= s.days %>: <%= s.hours %><br>
                <% }) %>
              </p>
            </div>
          </div>
          <a class="btn btn--primary" href="#booking" data-modal-open>Записатись на прийом</a>
        </div>

        <div class="contacts__map reveal">
          <figure class="contacts__photo">
            <img src="/img/photos/storefront.jpg?v=<%= v('/img/photos/storefront.jpg') %>"
                 width="408" height="306" loading="lazy" decoding="async"
                 alt="Фасад ветеринарної клініки Pussy Cat на вул. Олександра Олеся, 21 у Харкові">
            <figcaption>Шукайте жовту вивіску «Ветеринарна клініка» — вхід із вулиці</figcaption>
          </figure>
          <iframe
            title="Карта — <%= clinic.name %>"
            src="https://maps.google.com/maps?q=<%= encodeURIComponent(clinic.mapQuery) %>&z=16&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ МОДАЛЬНЕ ВІКНО ВІДГУКУ ══ -->
  <dialog class="modal modal--review" id="reviewModal" aria-labelledby="rvName">
    <div class="modal__box">
      <button class="modal__close" type="button" data-modal-close aria-label="Закрити">
        <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-close"/></svg>
      </button>

      <div class="modal__head">
        <span class="avatar avatar--lg" data-rv="avatar"></span>
        <div>
          <h2 id="rvName" data-rv="name"></h2>
          <p class="modal__sub">
            <span class="stars" aria-label="5 з 5">★★★★★</span>
            <span data-rv="pet"></span>
          </p>
        </div>
      </div>

      <div class="modal__body">
        <blockquote class="rv-text" data-rv="text"></blockquote>
      </div>

      <a class="btn btn--ghost btn--sm rv-link" href="<%= clinic.googleReviewsUrl %>"
         target="_blank" rel="noopener">Усі відгуки в Google Maps</a>
    </div>
  </dialog>

  <!-- ══ МОДАЛЬНЕ ВІКНО ЗАПИСУ ══ -->
  <dialog class="modal" id="bookingModal" aria-labelledby="modalTitle">
    <div class="modal__box">
      <button class="modal__close" type="button" data-modal-close aria-label="Закрити">
        <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-close"/></svg>
      </button>

      <div class="modal__head">
        <img src="/img/logo.svg?v=<%= v('/img/logo.svg') %>" width="52" height="52" alt="">
        <div>
          <h2 id="modalTitle">Запис на прийом</h2>
          <p>Передзвонимо й підберемо зручний час</p>
        </div>
      </div>

      <div class="modal__body">
        <%- include('partials/form', { prefix: 'mod', serviceOptions: serviceOptions, petAgeOptions: petAgeOptions, scheduleByWeekday: scheduleByWeekday }) %>
      </div>
    </div>
  </dialog>
</main>

<%- include('partials/footer', { clinic: clinic }) %>
<script src="/js/app.js?v=<%= v('/js/app.js') %>" defer></script>
</body>
</html>
