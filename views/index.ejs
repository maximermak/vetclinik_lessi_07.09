<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<%
  var M = t.meta;
  var vars = {
    name: clinic.name, city: clinic.city, cityIn: clinic.cityIn,
    district: clinic.district, districtIn: clinic.districtIn,
    address: clinic.address, schedule: clinic.scheduleShort,
    tagline: clinic.tagline, metro: clinic.metro, old: clinic.addressOld
  };
%>
<title><%= fill(M.title, vars) %></title>
<meta name="description" content="<%= fill(M.description, vars) %>">
<link rel="canonical" href="<%= siteUrl + alt[lang] %>">
<% LANGS.forEach(function (l) { %>
<link rel="alternate" hreflang="<%= l %>" href="<%= siteUrl + alt[l] %>">
<% }) %>
<link rel="alternate" hreflang="x-default" href="<%= siteUrl %>/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= fill(M.siteName, vars) %>">
<meta property="og:locale" content="<%= lang === 'ru' ? 'ru_UA' : 'uk_UA' %>">
<meta property="og:url" content="<%= siteUrl + alt[lang] %>">
<meta property="og:title" content="<%= fill(M.ogTitle, vars) %>">
<meta property="og:description" content="<%= fill(M.ogDescription, vars) %>">
<meta property="og:image" content="<%= siteUrl %>/img/og.jpg?v=<%= v('/img/og.jpg') %>">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="<%= fill(M.ogAlt, vars) %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= fill(M.ogTitle, vars) %>">
<meta name="twitter:description" content="<%= fill(M.twDescription, vars) %>">
<meta name="twitter:image" content="<%= siteUrl %>/img/og.jpg?v=<%= v('/img/og.jpg') %>">
<meta name="theme-color" content="#15705c">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="preload" href="/fonts/manrope-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/style.css?v=<%= v('/css/style.css') %>">
<%- include('partials/analytics') %>
<script type="application/ld+json">
<%- JSON.stringify(Object.assign({
  '@context': 'https://schema.org',
  '@type': 'VeterinaryCare',
  name: fill(M.schemaName, vars),
  alternateName: clinic.alternateNames,
  description: fill(M.schemaDescription, vars),
  url: siteUrl + alt[lang],
  inLanguage: lang,
  address: {
    '@type': 'PostalAddress',
    streetAddress: clinic.address,
    addressLocality: clinic.city,
    postalCode: clinic.postalCode,
    addressCountry: 'UA'
  },
  geo: { '@type': 'GeoCoordinates', latitude: clinic.geo.lat, longitude: clinic.geo.lng },
  hasMap: clinic.googleReviewsUrl,
  areaServed: [
    { '@type': 'City', name: clinic.city },
    { '@type': 'Place', name: clinic.district }
  ],
  image: siteUrl + '/img/og.jpg',
  logo: siteUrl + '/img/logo.svg',
  telephone: clinic.phones.map(function (p) { return p.raw; }),
  email: clinic.email,
  openingHoursSpecification: clinic.schedule.map(function (s) {
    return { '@type': 'OpeningHoursSpecification', dayOfWeek: s.dayOfWeek, opens: s.opens, closes: s.closes };
  }),
  sameAs: [clinic.googleReviewsUrl],
  availableService: services.map(function (s) { return { '@type': 'MedicalProcedure', name: s.title }; })
}, clinic.rating ? {
  // рейтинг у розмітці лише тоді, коли він справді прийшов з Google
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: String(clinic.rating).replace(',', '.'),
    reviewCount: clinic.reviewsCount
  }
} : {})) %>
</script>
<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: faq.map(function (f) {
    return { '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } };
  })
}) %>
</script>
</head>
<body>
<a class="skip" href="#main"><%= t.skip %></a>
<span id="top" aria-hidden="true"></span>
<%- include('partials/icons') %>
<%- include('partials/header') %>

<main id="main" tabindex="-1">
  <!-- ══ HERO ══ -->
  <section class="hero">
    <div class="hero__paws" aria-hidden="true"></div>
    <div class="container hero__in">
      <div class="hero__text reveal">
        <span class="eyebrow"><svg viewBox="0 0 24 24" class="icon icon--sm icon--fill" aria-hidden="true"><use href="#i-paw"/></svg> <%= fill(t.hero.eyebrow, vars) %></span>
        <h1><%= t.hero.h1a %><br><%= t.hero.h1b %> <span class="hl"><%= t.hero.h1c %></span></h1>
        <p class="hero__lead"><%= fill(t.hero.lead, vars) %></p>

        <div class="hero__cta">
          <a class="btn btn--primary" href="#booking" data-modal-open><%= t.nav.book %></a>
          <a class="btn btn--ghost" href="tel:<%= clinic.phones[0].raw %>">
            <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-phone"/></svg>
            <%= t.hero.call %>
          </a>
        </div>

        <div class="hero__trust">
          <% if (clinic.rating) { %>
            <a class="rating" href="<%= clinic.googleReviewsUrl %>" target="_blank" rel="noopener">
              <% var ratingParts = String(clinic.rating).split(','); %>
              <span class="rating__score"><%= ratingParts[0] %><% if (ratingParts.length > 1) { %><span class="rating__sep">,</span><%= ratingParts[1] %><% } %></span>
              <span class="rating__body">
                <span class="stars" aria-hidden="true">★★★★★</span>
                <span class="rating__label"><%= clinic.reviewsCount %> <%= t.hero.reviewsCount %></span>
              </span>
            </a>
          <% } else { %>
            <a class="rating rating--plain" href="<%= clinic.googleReviewsUrl %>" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-pin"/></svg>
              <span class="rating__body">
                <span class="rating__title"><%= t.hero.reviewsTitle %></span>
                <span class="rating__label"><%= t.hero.reviewsSub %></span>
              </span>
            </a>
          <% } %>
          <span class="hero__stat"><b>7</b> <%= t.hero.days %></span>
        </div>
      </div>

      <aside class="hero__card reveal">
        <div class="hcard">
          <div class="hcard__head">
            <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-clock"/></svg>
            <h2><%= t.hero.scheduleTitle %></h2>
          </div>
          <ul class="hcard__hours">
            <% clinic.schedule.forEach(function (s) { %>
              <li><span><%= s.days %></span><b><%= s.hours %></b></li>
            <% }) %>
          </ul>
          <div class="hcard__phones">
            <% clinic.phones.forEach(function (p) { %>
              <a href="tel:<%= p.raw %>">
                <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-phone"/></svg>
                <span class="hcard__num"><%= p.pretty %></span>
                <% if (p.person) { %><small><%= p.person %></small><% } %>
              </a>
            <% }) %>
          </div>
          <p class="hcard__note"><%= t.hero.note %></p>
        </div>
      </aside>
    </div>
  </section>

  <!-- ══ ПЕРЕВАГИ-СТРІЧКА ══ -->
  <section class="strip">
    <div class="container strip__in">
      <% t.strip.forEach(function (s) { %>
        <div class="strip__item reveal">
          <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-<%= s.icon %>"/></svg>
          <span><%= s.title %><br><small><%= s.sub %></small></span>
        </div>
      <% }) %>
    </div>
  </section>

  <!-- ══ ПОСЛУГИ ══ -->
  <section class="section" id="services">
    <div class="container">
      <header class="section__head reveal">
        <span class="eyebrow"><%= t.servicesSec.eyebrow %></span>
        <h2><%= t.servicesSec.h2a %><br><%= t.servicesSec.h2b %></h2>
        <p><%= t.servicesSec.lead %></p>
      </header>

      <div class="services">
        <% services.forEach(function (s) { %>
          <a class="srv reveal" href="#booking" data-modal-open data-service="<%= s.title %>">
            <span class="srv__icon">
              <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-<%= s.icon %>"/></svg>
            </span>
            <span class="srv__body">
              <span class="srv__title"><%= s.title %></span>
              <span class="srv__text"><%= s.text %></span>
            </span>
            <svg viewBox="0 0 24 24" class="icon icon--sm srv__go" aria-hidden="true"><use href="#i-chev"/></svg>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ══ КОГО ЛІКУЄМО ══ -->
  <section class="pets" id="pets">
    <div class="container">
      <div class="pets__head reveal">
        <div class="pets__intro">
          <span class="eyebrow eyebrow--light"><%= t.petsSec.eyebrow %></span>
          <h2><%= t.petsSec.h2 %></h2>
          <p><%= t.petsSec.lead %></p>
        </div>

        <div class="pets__photos">
          <img class="pphoto pphoto--main"
               src="/img/photos/clinic-wall.webp?v=<%= v('/img/photos/clinic-wall.webp') %>"
               width="880" height="660" loading="lazy" decoding="async"
               alt="<%= fill(t.petsSec.photoMain, vars) %>">
          <img class="pphoto pphoto--accent"
               src="/img/photos/anatomy.webp?v=<%= v('/img/photos/anatomy.webp') %>"
               width="560" height="420" loading="lazy" decoding="async"
               alt="<%= t.petsSec.photoAccent %>">
        </div>
      </div>

      <div class="grid grid--pets">
        <% smallPets.forEach(function (p) { %>
          <article class="pcard reveal<%= p.cta ? ' pcard--cta' : '' %>">
            <% if (p.img) { %>
              <img class="pcard__art" src="/img/pets/<%= p.img %>.svg?v=<%= v('/img/pets/' + p.img + '.svg') %>"
                   width="76" height="76" loading="lazy" decoding="async" alt="">
            <% } else { %>
              <span class="pcard__icon">
                <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-<%= p.icon %>"/></svg>
              </span>
            <% } %>
            <h3><%= p.title %></h3>
            <p><%= p.text %></p>
          </article>
        <% }) %>
      </div>

      <div class="pets__cta reveal">
        <a class="btn btn--amber" href="tel:<%= clinic.phones[0].raw %>">
          <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-phone"/></svg>
          <%= clinic.phones[0].pretty %>
        </a>
        <span><%= t.petsSec.ctaNote %></span>
      </div>
    </div>
  </section>

  <!-- ══ ЧОМУ МИ ══ -->
  <section class="section section--cream" id="why">
    <div class="container">
      <header class="section__head reveal">
        <span class="eyebrow"><%= t.whySec.eyebrow %></span>
        <h2><%= t.whySec.h2 %></h2>
        <p><%= t.whySec.lead %></p>
      </header>

      <div class="grid grid--why">
        <% advantages.forEach(function (a, i) { %>
          <article class="why reveal">
            <span class="why__num"><%= String(i + 1).padStart(2, '0') %></span>
            <h3><%= a.title %></h3>
            <p><%= a.text %></p>
          </article>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ══ ВІДГУКИ ══ -->
  <section class="section" id="reviews">
    <div class="container">
      <header class="section__head reveal">
        <span class="eyebrow"><%= t.reviewsSec.eyebrow %></span>
        <h2><%= t.reviewsSec.h2 %></h2>
        <p><%= t.reviewsSec.leadA %> <a href="<%= clinic.googleReviewsUrl %>" target="_blank" rel="noopener"><%= t.reviewsSec.leadLink %></a><%= t.reviewsSec.leadB %></p>
      </header>

      <div class="grid grid--reviews">
        <% reviews.forEach(function (r) { %>
          <figure class="review reveal<%= r.full ? ' review--more' : '' %>"
            <% if (r.full) { %>
              data-review data-name="<%= r.name %>" data-pet="<%= r.pet %>" data-full="<%= r.full %>"
              role="button" tabindex="0" aria-label="<%= t.reviewsSec.readAria %>: <%= r.name %>"
            <% } %>>
            <div class="review__top">
              <span class="avatar"><%= r.name.charAt(0) %></span>
              <div class="review__who">
                <b><%= r.name %></b>
                <span class="review__meta">
                  <span class="stars" aria-label="5 / 5">★★★★★</span>
                  <span class="review__pet"><%= r.pet %></span>
                </span>
              </div>
            </div>
            <blockquote>«<%= r.text %>»</blockquote>
            <% if (r.full) { %>
              <span class="review__more">
                <%= t.reviewsSec.readMore %>
                <svg viewBox="0 0 24 24" class="icon icon--sm" aria-hidden="true"><use href="#i-chev"/></svg>
              </span>
            <% } %>
          </figure>
        <% }) %>
      </div>

      <div class="reviews__more reveal">
        <a class="btn btn--ghost" href="<%= clinic.googleReviewsUrl %>" target="_blank" rel="noopener">
          <%= t.reviewsSec.all %>
        </a>
      </div>
    </div>
  </section>

  <!-- ══ ЗАЯВКА ══ -->
  <section class="booking" id="booking">
    <div class="container booking__in">
      <div class="booking__text reveal">
        <span class="eyebrow eyebrow--light"><%= t.bookingSec.eyebrow %></span>
        <h2><%= t.bookingSec.h2a %><br><%= t.bookingSec.h2b %></h2>
        <p><%= t.bookingSec.lead %></p>
        <ul class="checks checks--light">
          <% t.bookingSec.checks.forEach(function (c) { %>
            <li><svg viewBox="0 0 24 24" class="icon icon--sm" aria-hidden="true"><use href="#i-check"/></svg><%= c %></li>
          <% }) %>
        </ul>
        <div class="booking__phones">
          <% clinic.phones.forEach(function (p) { %>
            <a href="tel:<%= p.raw %>"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-phone"/></svg><%= p.pretty %></a>
          <% }) %>
        </div>

        <div class="booking__pets" aria-hidden="true">
          <% smallPets.filter(function (p) { return p.img; }).forEach(function (p) { %>
            <img src="/img/pets/<%= p.img %>.svg?v=<%= v('/img/pets/' + p.img + '.svg') %>"
                 width="58" height="58" loading="lazy" decoding="async" alt="">
          <% }) %>
          <span><%= t.bookingSec.petsNote %></span>
        </div>
      </div>

      <div class="formwrap reveal">
        <h3 class="form__title"><%= t.bookingSec.formTitle %></h3>
        <%- include('partials/form', { prefix: 'sec' }) %>
      </div>
    </div>
  </section>

  <!-- ══ FAQ ══ -->
  <section class="section section--cream" id="faq">
    <div class="container container--narrow">
      <header class="section__head reveal">
        <span class="eyebrow"><%= t.faqSec.eyebrow %></span>
        <h2><%= t.faqSec.h2 %></h2>
      </header>

      <div class="faq">
        <% faq.forEach(function (f) { %>
          <details class="faq__item reveal">
            <summary><%= f.q %><svg viewBox="0 0 24 24" class="icon icon--sm" aria-hidden="true"><use href="#i-chev"/></svg></summary>
            <div class="faq__body"><p><%= f.a %></p></div>
          </details>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ══ КОНТАКТИ ══ -->
  <section class="section contacts" id="contacts">
    <div class="container">
      <header class="section__head reveal">
        <span class="eyebrow"><%= t.contactsSec.eyebrow %></span>
        <h2><%= t.contactsSec.h2 %></h2>
      </header>

      <div class="contacts__in">
        <div class="contacts__info reveal">
          <div class="cinfo">
            <span class="cinfo__ic"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-pin"/></svg></span>
            <div>
              <b><%= t.contactsSec.address %></b>
              <p>
                <%= clinic.addressFull %>
                <span class="cinfo__old"><%= fill(t.contactsSec.oldName, vars) %></span>
                <span class="cinfo__old"><%= fill(t.contactsSec.nearMetro, vars) %></span>
                <a href="<%= clinic.googleReviewsUrl %>" target="_blank" rel="noopener"><%= t.contactsSec.openMaps %></a>
              </p>
            </div>
          </div>
          <div class="cinfo">
            <span class="cinfo__ic"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-phone"/></svg></span>
            <div>
              <b><%= t.contactsSec.phone %></b>
              <p>
                <% clinic.phones.forEach(function (p) { %>
                  <a href="tel:<%= p.raw %>"><%= p.pretty %></a><% if (p.person) { %> — <%= p.person %><% } %><br>
                <% }) %>
              </p>
            </div>
          </div>
          <% if (clinic.email) { %>
          <div class="cinfo">
            <span class="cinfo__ic"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-mail"/></svg></span>
            <div>
              <b><%= t.contactsSec.mail %></b>
              <p><a href="mailto:<%= clinic.email %>"><%= clinic.email %></a></p>
            </div>
          </div>
          <% } %>
          <div class="cinfo">
            <span class="cinfo__ic"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-clock"/></svg></span>
            <div>
              <b><%= t.contactsSec.schedule %></b>
              <p>
                <% clinic.schedule.forEach(function (s) { %>
                  <%= s.days %>: <%= s.hours %><br>
                <% }) %>
              </p>
            </div>
          </div>
          <a class="btn btn--primary" href="#booking" data-modal-open><%= t.nav.book %></a>
        </div>

        <div class="contacts__map reveal">
          <figure class="contacts__photo">
            <img src="/img/photos/entrance.webp?v=<%= v('/img/photos/entrance.webp') %>"
                 width="1000" height="417" loading="lazy" decoding="async"
                 alt="<%= fill(t.contactsSec.photoAlt, vars) %>">
            <figcaption><%= t.contactsSec.photoCaption %></figcaption>
          </figure>
          <iframe
            title="<%= fill(t.contactsSec.mapTitle, { name: clinic.name, address: clinic.addressFull }) %>"
            src="https://maps.google.com/maps?q=<%= encodeURIComponent(clinic.geo.lat + ',' + clinic.geo.lng + ' (' + fill(M.schemaName, vars) + ')') %>&hl=<%= lang %>&z=17&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </div>
  </section>

  <% if (reviews.some(function (r) { return r.full; })) { %>
  <dialog class="modal modal--review" id="reviewModal" aria-labelledby="rvName">
    <div class="modal__box">
      <button class="modal__close" type="button" data-modal-close aria-label="<%= t.nav.close %>">
        <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-close"/></svg>
      </button>
      <div class="modal__head">
        <span class="avatar avatar--lg" data-rv="avatar"></span>
        <div>
          <h2 id="rvName" data-rv="name"></h2>
          <p class="modal__sub"><span class="stars" aria-label="5 / 5">★★★★★</span><span data-rv="pet"></span></p>
        </div>
      </div>
      <div class="modal__body"><blockquote class="rv-text" data-rv="text"></blockquote></div>
      <a class="btn btn--ghost btn--sm rv-link" href="<%= clinic.googleReviewsUrl %>"
         target="_blank" rel="noopener"><%= t.reviewsSec.all %></a>
    </div>
  </dialog>
  <% } %>

  <!-- ══ МОДАЛЬНЕ ВІКНО ЗАПИСУ ══ -->
  <dialog class="modal" id="bookingModal" aria-labelledby="modalTitle">
    <div class="modal__box">
      <button class="modal__close" type="button" data-modal-close aria-label="<%= t.nav.close %>">
        <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-close"/></svg>
      </button>

      <div class="modal__head">
        <img src="/img/logo.svg?v=<%= v('/img/logo.svg') %>" width="52" height="52" alt="">
        <div>
          <h2 id="modalTitle"><%= t.bookingSec.modalTitle %></h2>
          <p><%= t.bookingSec.modalSub %></p>
        </div>
      </div>

      <div class="modal__body">
        <%- include('partials/form', { prefix: 'mod' }) %>
      </div>
    </div>
  </dialog>
</main>

<%- include('partials/footer') %>
<script src="/js/app.js?v=<%= v('/js/app.js') %>" defer></script>
</body>
</html>
