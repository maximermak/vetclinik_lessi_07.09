<!doctype html>
<html lang="uk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= clinic.name %> — ветеринарна клініка у <%= clinic.cityIn %>, працюємо щодня</title>
<meta name="description" content="Ветклініка «<%= clinic.name %>» на <%= clinic.districtIn %>, <%= clinic.city %> — <%= clinic.address %> (<%= clinic.addressOld %>), поруч з метро «<%= clinic.metro %>». Терапія, хірургія, вакцинація, аналізи. Коти, собаки, морські свинки, кролики, гризуни. <%= clinic.scheduleShort %> без вихідних.">
<link rel="canonical" href="<%= siteUrl %>/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Ветклініка «<%= clinic.name %>»">
<meta property="og:locale" content="uk_UA">
<meta property="og:url" content="<%= siteUrl %>/">
<meta property="og:title" content="Ветклініка «<%= clinic.name %>» — щодня 09:00–19:00 у <%= clinic.cityIn %>">
<meta property="og:description" content="Терапія, хірургія, вакцинація та аналізи. Коти, собаки, морські свинки, кролики й гризуни. <%= clinic.address %>. Запис онлайн за хвилину.">
<meta property="og:image" content="<%= siteUrl %>/img/og.jpg?v=<%= v('/img/og.jpg') %>">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Ветеринарна клініка «Лессі» — лікуємо тих, хто чекає вас удома">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Ветклініка «<%= clinic.name %>» — щодня 09:00–19:00 у <%= clinic.cityIn %>">
<meta name="twitter:description" content="Терапія, хірургія, вакцинація та аналізи. Коти, собаки, морські свинки, кролики й гризуни.">
<meta name="twitter:image" content="<%= siteUrl %>/img/og.jpg?v=<%= v('/img/og.jpg') %>">
<meta name="theme-color" content="#15705c">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css?v=<%= v('/css/style.css') %>">
<%- include('partials/analytics') %>
<script type="application/ld+json">
<%- JSON.stringify(Object.assign({
  '@context': 'https://schema.org',
  '@type': 'VeterinaryCare',
  name: 'Ветеринарна клініка «' + clinic.name + '»',
  description: clinic.tagline + ' у ' + clinic.cityIn + ': терапія, хірургія, вакцинація, аналізи. Коти, собаки, морські свинки, кролики та гризуни.',
  url: siteUrl + '/',
  address: {
    '@type': 'PostalAddress',
    streetAddress: clinic.address,
    addressLocality: clinic.city,
    postalCode: '61168',
    addressCountry: 'UA'
  },
  geo: { '@type': 'GeoCoordinates', latitude: clinic.geo.lat, longitude: clinic.geo.lng },
  hasMap: clinic.googleReviewsUrl,
  areaServed: { '@type': 'City', name: clinic.city },
  image: siteUrl + '/img/og.jpg',
  logo: siteUrl + '/img/logo.svg',
  telephone: clinic.phones.map(function (p) { return p.raw; }),
  email: clinic.email,
  openingHoursSpecification: clinic.schedule.map(function (s) {
    return { '@type': 'OpeningHoursSpecification', dayOfWeek: s.dayOfWeek, opens: s.opens, closes: s.closes };
  }),
  sameAs: [clinic.googleReviewsUrl],
  availableService: services.map(function (s) { return { '@type': 'MedicalProcedure', name: s.title }; })
}, clinic.rating ? {
  // рейтинг у розмітці лише тоді, коли він справді прийшов з Google
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: String(clinic.rating).replace(',', '.'),
    reviewCount: clinic.reviewsCount
  }
} : {})) %>
</script>
<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(function (f) {
    return {
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a }
    };
  })
}) %>
</script>
</head>
<body>
<%- include('partials/icons') %>
<%- include('partials/header', { clinic: clinic }) %>

<main>
  <!-- ══ HERO ══ -->
  <section class="hero">
    <div class="hero__paws" aria-hidden="true"></div>
    <div class="container hero__in">
      <div class="hero__text reveal">
        <span class="eyebrow"><svg viewBox="0 0 24 24" class="icon icon--sm icon--fill" aria-hidden="true"><use href="#i-paw"/></svg> Ветклініка у <%= clinic.cityIn %> — щодня</span>
        <h1>Лікуємо тих,<br>хто <span class="hl">чекає вас удома</span></h1>
        <p class="hero__lead">
          Терапія, хірургія, вакцинація та аналізи в одній клініці
          на <%= clinic.districtIn %>. Приймаємо котів і собак, а ще морських
          свинок, кроликів і гризунів — щодня з 09:00 до 19:00, без вихідних.
        </p>

        <div class="hero__cta">
          <a class="btn btn--primary" href="#booking" data-modal-open>Записатись на прийом</a>
          <a class="btn btn--ghost" href="tel:<%= clinic.phones[0].raw %>">
            <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-phone"/></svg>
            Зателефонувати
          </a>
        </div>

        <div class="hero__trust">
          <% if (clinic.rating) { %>
            <a class="rating" href="<%= clinic.googleReviewsUrl %>" target="_blank" rel="noopener">
              <% var ratingParts = String(clinic.rating).split(','); %>
              <span class="rating__score"><%= ratingParts[0] %><% if (ratingParts.length > 1) { %><span class="rating__sep">,</span><%= ratingParts[1] %><% } %></span>
              <span class="rating__body">
                <span class="stars" aria-hidden="true">★★★★★</span>
                <span class="rating__label"><%= clinic.reviewsCount %> <%= plural(clinic.reviewsCount, 'відгук', 'відгуки', 'відгуків') %> у Google Maps</span>
              </span>
            </a>
          <% } else { %>
            <a class="rating rating--plain" href="<%= clinic.googleReviewsUrl %>" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-pin"/></svg>
              <span class="rating__body">
                <span class="rating__title">Відгуки власників</span>
                <span class="rating__label">читайте на нашій сторінці в Google Maps</span>
              </span>
            </a>
          <% } %>
          <span class="hero__stat"><b>7</b> днів на тиждень</span>
        </div>
      </div>

      <aside class="hero__card reveal">
        <div class="hcard">
          <div class="hcard__head">
            <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-clock"/></svg>
            <h2>Графік роботи</h2>
          </div>
          <ul class="hcard__hours">
            <% clinic.schedule.forEach(function (s) { %>
              <li><span><%= s.days %></span><b><%= s.hours %></b></li>
            <% }) %>
          </ul>
          <div class="hcard__phones">
            <% clinic.phones.forEach(function (p) { %>
              <a href="tel:<%= p.raw %>">
                <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-phone"/></svg>
                <span class="hcard__num"><%= p.pretty %></span>
                <% if (p.person) { %><small><%= p.person %></small><% } %>
              </a>
            <% }) %>
          </div>
          <p class="hcard__note">Гострий стан не чекає запису — телефонуйте й везіть. Останній плановий прийом краще планувати до 18:30.</p>
        </div>
      </aside>
    </div>
  </section>

  <!-- ══ ПЕРЕВАГИ-СТРІЧКА ══ -->
  <section class="strip">
    <div class="container strip__in">
      <div class="strip__item reveal"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-clock"/></svg><span>Щодня 09:00–19:00<br><small>без вихідних і свят</small></span></div>
      <div class="strip__item reveal"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-rodent"/></svg><span>Дрібні тварини<br><small>свинки, кролики, гризуни</small></span></div>
      <div class="strip__item reveal"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-stethoscope"/></svg><span>Терапія і хірургія<br><small>від огляду до операції</small></span></div>
      <div class="strip__item reveal"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-shield"/></svg><span>Ціна — до початку<br><small>без несподіванок у касі</small></span></div>
    </div>
  </section>

  <!-- ══ ПОСЛУГИ ══ -->
  <section class="section" id="services">
    <div class="container">
      <header class="section__head reveal">
        <span class="eyebrow">Наші послуги</span>
        <h2>Усе для здоров’я улюбленця<br>в одній клініці</h2>
        <p>Не потрібно возити тварину містом: огляд, аналізи, операція та спостереження — на одній адресі.</p>
      </header>

      <div class="services">
        <% services.forEach(function (s) { %>
          <a class="srv reveal" href="#booking" data-modal-open data-service="<%= s.title %>">
            <span class="srv__icon">
              <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-<%= s.icon %>"/></svg>
            </span>
            <span class="srv__body">
              <span class="srv__title"><%= s.title %></span>
              <span class="srv__text"><%= s.text %></span>
            </span>
            <svg viewBox="0 0 24 24" class="icon icon--sm srv__go" aria-hidden="true"><use href="#i-chev"/></svg>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ══ КОГО ЛІКУЄМО ══ -->
  <section class="pets" id="pets">
    <div class="container">
      <div class="pets__head reveal">
        <div class="pets__intro">
          <span class="eyebrow eyebrow--light">Кого ми лікуємо</span>
          <h2>Не лише котів і собак</h2>
          <p>
            Морські свинки, кролики та гризуни — пацієнти, з якими беруться далеко не всі.
            У них інша анатомія, інші дози і зовсім мало часу на помилку.
          </p>
        </div>

        <div class="pets__photos">
          <img class="pphoto pphoto--main"
               src="/img/photos/clinic-wall.webp?v=<%= v('/img/photos/clinic-wall.webp') %>"
               width="880" height="660" loading="lazy" decoding="async"
               alt="Кабінет ветклініки «Лессі»: стіна з таблицями порід котів і собак">
          <img class="pphoto pphoto--accent"
               src="/img/photos/anatomy.webp?v=<%= v('/img/photos/anatomy.webp') %>"
               width="560" height="420" loading="lazy" decoding="async"
               alt="Анатомічний плакат скелета собаки в кабінеті клініки">
        </div>
      </div>

      <div class="grid grid--pets">
        <% smallPets.forEach(function (p) { %>
          <article class="pcard reveal<%= p.cta ? ' pcard--cta' : '' %>">
            <% if (p.img) { %>
              <img class="pcard__art" src="/img/pets/<%= p.img %>.svg?v=<%= v('/img/pets/' + p.img + '.svg') %>"
                   width="76" height="76" loading="lazy" decoding="async" alt="">
            <% } else { %>
              <span class="pcard__icon">
                <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-<%= p.icon %>"/></svg>
              </span>
            <% } %>
            <h3><%= p.title %></h3>
            <p><%= p.text %></p>
          </article>
        <% }) %>
      </div>

      <div class="pets__cta reveal">
        <a class="btn btn--amber" href="tel:<%= clinic.phones[0].raw %>">
          <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-phone"/></svg>
          <%= clinic.phones[0].pretty %>
        </a>
        <span>Опишіть тварину телефоном — скажемо, чи зможемо допомогти</span>
      </div>
    </div>
  </section>

  <!-- ══ ЧОМУ МИ ══ -->
  <section class="section section--cream" id="why">
    <div class="container">
      <header class="section__head reveal">
        <span class="eyebrow">Чому нас обирають</span>
        <h2>Клініка, куди повертаються</h2>
        <p>Нас знаходять за порадою друзів — і лишаються з тією ж твариною роками.</p>
      </header>

      <div class="grid grid--why">
        <% advantages.forEach(function (a, i) { %>
          <article class="why reveal">
            <span class="why__num"><%= String(i + 1).padStart(2, '0') %></span>
            <h3><%= a.title %></h3>
            <p><%= a.text %></p>
          </article>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ══ ВІДГУКИ ══ -->
  <section class="section" id="reviews">
    <div class="container">
      <header class="section__head reveal">
        <span class="eyebrow">Відгуки</span>
        <h2>Що кажуть власники</h2>
        <p>Кілька відгуків із <a href="<%= clinic.googleReviewsUrl %>" target="_blank" rel="noopener">нашої сторінки в Google Maps</a>. Там же є і критика — читайте все, перш ніж їхати.</p>
      </header>

      <div class="grid grid--reviews">
        <% reviews.forEach(function (r) { %>
          <figure class="review reveal<%= r.full ? ' review--more' : '' %>"
            <% if (r.full) { %>
              data-review
              data-name="<%= r.name %>"
              data-pet="<%= r.pet %>"
              data-full="<%= r.full %>"
              role="button" tabindex="0"
              aria-label="Читати повний відгук: <%= r.name %>"
            <% } %>>
            <div class="review__top">
              <span class="avatar"><%= r.name.charAt(0) %></span>
              <div class="review__who">
                <b><%= r.name %></b>
                <span class="review__meta">
                  <span class="stars" aria-label="5 з 5">★★★★★</span>
                  <span class="review__pet"><%= r.pet %></span>
                </span>
              </div>
            </div>
            <blockquote>«<%= r.text %>»</blockquote>
            <% if (r.full) { %>
              <span class="review__more">
                Читати повністю
                <svg viewBox="0 0 24 24" class="icon icon--sm" aria-hidden="true"><use href="#i-chev"/></svg>
              </span>
            <% } %>
          </figure>
        <% }) %>
      </div>

      <div class="reviews__more reveal">
        <a class="btn btn--ghost" href="<%= clinic.googleReviewsUrl %>" target="_blank" rel="noopener">
          Усі відгуки в Google Maps
        </a>
      </div>
    </div>
  </section>

  <!-- ══ ЗАЯВКА ══ -->
  <section class="booking" id="booking">
    <div class="container booking__in">
      <div class="booking__text reveal">
        <span class="eyebrow eyebrow--light">Онлайн-запис</span>
        <h2>Запишіться<br>за одну хвилину</h2>
        <p>
          Заповніть форму — заявка миттєво прилетить адміністратору в Telegram.
          Ми передзвонимо в робочі години й підберемо зручний час.
        </p>
        <ul class="checks checks--light">
          <li><svg viewBox="0 0 24 24" class="icon icon--sm" aria-hidden="true"><use href="#i-check"/></svg>Передзвонюємо в робочі години, 09:00–19:00</li>
          <li><svg viewBox="0 0 24 24" class="icon icon--sm" aria-hidden="true"><use href="#i-check"/></svg>Підкажемо, як підготувати тварину</li>
          <li><svg viewBox="0 0 24 24" class="icon icon--sm" aria-hidden="true"><use href="#i-check"/></svg>Озвучимо вартість заздалегідь</li>
        </ul>
        <div class="booking__phones">
          <% clinic.phones.forEach(function (p) { %>
            <a href="tel:<%= p.raw %>"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-phone"/></svg><%= p.pretty %></a>
          <% }) %>
        </div>

        <div class="booking__pets" aria-hidden="true">
          <% smallPets.filter(function (p) { return p.img; }).forEach(function (p) { %>
            <img src="/img/pets/<%= p.img %>.svg?v=<%= v('/img/pets/' + p.img + '.svg') %>"
                 width="58" height="58" loading="lazy" decoding="async" alt="">
          <% }) %>
          <span>приймаємо всіх</span>
        </div>
      </div>

      <div class="formwrap reveal">
        <h3 class="form__title">Заявка на прийом</h3>
        <%- include('partials/form', { prefix: 'sec', serviceOptions: serviceOptions, petAgeOptions: petAgeOptions, scheduleByWeekday: scheduleByWeekday }) %>
      </div>
    </div>
  </section>

  <!-- ══ FAQ ══ -->
  <section class="section section--cream" id="faq">
    <div class="container container--narrow">
      <header class="section__head reveal">
        <span class="eyebrow">Часті питання</span>
        <h2>Коротко про головне</h2>
      </header>

      <div class="faq">
        <% faq.forEach(function (f) { %>
          <details class="faq__item reveal">
            <summary><%= f.q %><svg viewBox="0 0 24 24" class="icon icon--sm" aria-hidden="true"><use href="#i-chev"/></svg></summary>
            <div class="faq__body"><p><%= f.a %></p></div>
          </details>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ══ КОНТАКТИ ══ -->
  <section class="section contacts" id="contacts">
    <div class="container">
      <header class="section__head reveal">
        <span class="eyebrow">Контакти</span>
        <h2>Як нас знайти</h2>
      </header>

      <div class="contacts__in">
        <div class="contacts__info reveal">
          <div class="cinfo">
            <span class="cinfo__ic"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-pin"/></svg></span>
            <div>
              <b>Адреса</b>
              <p>
                <%= clinic.addressFull %>
                <span class="cinfo__old"><%= clinic.addressOld %> — за старою назвою нас теж знають</span>
                <span class="cinfo__old"><%= clinic.district %>, поруч зі станцією метро «<%= clinic.metro %>»</span>
                <a href="<%= clinic.googleReviewsUrl %>" target="_blank" rel="noopener">Відкрити в Google Maps</a>
              </p>
            </div>
          </div>
          <div class="cinfo">
            <span class="cinfo__ic"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-phone"/></svg></span>
            <div>
              <b>Телефон</b>
              <p>
                <% clinic.phones.forEach(function (p) { %>
                  <a href="tel:<%= p.raw %>"><%= p.pretty %></a><% if (p.person) { %> — <%= p.person %><% } %><br>
                <% }) %>
              </p>
            </div>
          </div>
          <% if (clinic.email) { %>
          <div class="cinfo">
            <span class="cinfo__ic"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-mail"/></svg></span>
            <div>
              <b>Пошта</b>
              <p><a href="mailto:<%= clinic.email %>"><%= clinic.email %></a></p>
            </div>
          </div>
          <% } %>
          <div class="cinfo">
            <span class="cinfo__ic"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-clock"/></svg></span>
            <div>
              <b>Графік роботи</b>
              <p>
                <% clinic.schedule.forEach(function (s) { %>
                  <%= s.days %>: <%= s.hours %><br>
                <% }) %>
              </p>
            </div>
          </div>
          <a class="btn btn--primary" href="#booking" data-modal-open>Записатись на прийом</a>

        </div>

        <div class="contacts__map reveal">
          <figure class="contacts__photo">
            <img src="/img/photos/entrance.webp?v=<%= v('/img/photos/entrance.webp') %>"
                 width="1000" height="417" loading="lazy" decoding="async"
                 alt="Вхід до ветклініки «Лессі» — сірі металеві двері збоку будівлі">
            <figcaption>Шукайте сірі металеві двері — це наш вхід</figcaption>
          </figure>
          <iframe
            title="Карта — ветклініка «<%= clinic.name %>», <%= clinic.addressFull %>"
            src="https://maps.google.com/maps?q=<%= encodeURIComponent(clinic.geo.lat + ',' + clinic.geo.lng + ' (Ветклініка «' + clinic.name + '»)') %>&hl=uk&z=17&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </div>
  </section>

  <% if (reviews.some(function (r) { return r.full; })) { %>
  <!-- ══ МОДАЛЬНЕ ВІКНО ВІДГУКУ ══ -->
  <dialog class="modal modal--review" id="reviewModal" aria-labelledby="rvName">
    <div class="modal__box">
      <button class="modal__close" type="button" data-modal-close aria-label="Закрити">
        <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-close"/></svg>
      </button>

      <div class="modal__head">
        <span class="avatar avatar--lg" data-rv="avatar"></span>
        <div>
          <h2 id="rvName" data-rv="name"></h2>
          <p class="modal__sub">
            <span class="stars" aria-label="5 з 5">★★★★★</span>
            <span data-rv="pet"></span>
          </p>
        </div>
      </div>

      <div class="modal__body">
        <blockquote class="rv-text" data-rv="text"></blockquote>
      </div>

      <a class="btn btn--ghost btn--sm rv-link" href="<%= clinic.googleReviewsUrl %>"
         target="_blank" rel="noopener">Усі відгуки в Google Maps</a>
    </div>
  </dialog>
  <% } %>

  <!-- ══ МОДАЛЬНЕ ВІКНО ЗАПИСУ ══ -->
  <dialog class="modal" id="bookingModal" aria-labelledby="modalTitle">
    <div class="modal__box">
      <button class="modal__close" type="button" data-modal-close aria-label="Закрити">
        <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-close"/></svg>
      </button>

      <div class="modal__head">
        <img src="/img/logo.svg?v=<%= v('/img/logo.svg') %>" width="52" height="52" alt="">
        <div>
          <h2 id="modalTitle">Запис на прийом</h2>
          <p>Передзвонимо й підберемо зручний час</p>
        </div>
      </div>

      <div class="modal__body">
        <%- include('partials/form', { prefix: 'mod', serviceOptions: serviceOptions, petAgeOptions: petAgeOptions, scheduleByWeekday: scheduleByWeekday }) %>
      </div>
    </div>
  </dialog>
</main>

<%- include('partials/footer', { clinic: clinic }) %>
<script src="/js/app.js?v=<%= v('/js/app.js') %>" defer></script>
</body>
</html>
