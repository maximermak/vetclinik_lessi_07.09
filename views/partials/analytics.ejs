<%
  /* Google Analytics 4. Ідентифікатор беремо зі змінної оточення
     GA_MEASUREMENT_ID: без неї скрипт не підключається взагалі.
     Так локальна розробка не потрапляє у статистику клієнта. */
%>
<% if (gaId) { %>
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= gaId %>"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '<%= gaId %>');
</script>
<% } %>
