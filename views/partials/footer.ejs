<footer class="footer">
  <div class="container footer__in">
    <div class="footer__brand">
      <img src="/img/logo.svg?v=<%= v('/img/logo.svg') %>" width="56" height="56" alt="">
      <div>
        <strong>«<%= clinic.name %>»</strong>
        <p><%= fill(t.footer.about, { tagline: clinic.tagline, cityIn: clinic.cityIn, address: clinic.address }) %></p>
      </div>
    </div>

    <div class="footer__col">
      <h3><%= t.footer.clinic %></h3>
      <a href="#services"><%= t.nav.services %></a>
      <a href="#pets"><%= t.nav.pets %></a>
      <a href="#why"><%= t.nav.why %></a>
      <a href="#faq"><%= t.faqSec.eyebrow %></a>
      <a href="<%= path(lang, '/privacy') %>"><%= t.footer.privacy %></a>
    </div>

    <div class="footer__col">
      <h3><%= t.footer.contacts %></h3>
      <% clinic.phones.forEach(function (p) { %>
        <a href="tel:<%= p.raw %>"><%= p.pretty %><% if (p.person) { %> — <%= p.person %><% } %></a>
      <% }) %>
      <% if (clinic.email) { %><a href="mailto:<%= clinic.email %>"><%= clinic.email %></a><% } %>
      <a href="<%= clinic.googleReviewsUrl %>" target="_blank" rel="noopener"><%= clinic.address %></a>
    </div>

    <div class="footer__col">
      <h3><%= t.footer.schedule %></h3>
      <% clinic.schedule.forEach(function (s) { %>
        <span><%= s.days %><br><b><%= s.hours %></b></span>
      <% }) %>
    </div>
  </div>

  <div class="container footer__bottom">
    <span><%= fill(t.footer.rights, { year: new Date().getFullYear(), name: clinic.name }) %></span>
    <a href="#top"><%= t.footer.top %></a>
  </div>
</footer>

<a class="fab" href="#booking" data-modal-open aria-label="<%= t.nav.book %>">
  <svg viewBox="0 0 24 24" class="icon icon--fill" aria-hidden="true"><use href="#i-paw"/></svg>
  <span><%= t.nav.bookShort %></span>
</a>
