<%
  // prefix робить id унікальними: форма існує двічі — у секції та в модальному вікні
  var p = typeof prefix !== 'undefined' ? prefix : 'f';
%>
<form class="form" data-lead-form novalidate>
  <div class="field field--full">
    <span class="field__label">Хто ваш улюбленець?</span>
    <div class="segmented" data-segmented role="radiogroup" aria-label="Вид тварини">
      <span class="segmented__thumb" aria-hidden="true"></span>
      <label class="segmented__opt">
        <input type="radio" name="petType" value="Кіт" checked>
        <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-cat"/></svg>
        <span>Кіт</span>
      </label>
      <label class="segmented__opt">
        <input type="radio" name="petType" value="Собака">
        <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-dog"/></svg>
        <span>Собака</span>
      </label>
      <label class="segmented__opt">
        <input type="radio" name="petType" value="Інша тварина">
        <svg viewBox="0 0 24 24" class="icon icon--fill" aria-hidden="true"><use href="#i-paw"/></svg>
        <span>Інша</span>
      </label>
    </div>
  </div>

  <div class="field">
    <label for="<%= p %>-name">Ваше ім’я <span>*</span></label>
    <div class="control">
      <svg viewBox="0 0 24 24" class="control__ic icon icon--sm" aria-hidden="true"><use href="#i-user"/></svg>
      <input id="<%= p %>-name" name="name" type="text" autocomplete="name" placeholder="Олена" required>
    </div>
    <small class="err" data-err="name"></small>
  </div>

  <div class="field">
    <label for="<%= p %>-phone">Телефон <span>*</span></label>
    <div class="control">
      <svg viewBox="0 0 24 24" class="control__ic icon icon--sm" aria-hidden="true"><use href="#i-phone"/></svg>
      <input id="<%= p %>-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel"
             placeholder="+38 (0__) ___-__-__" required>
    </div>
    <small class="err" data-err="phone"></small>
  </div>

  <div class="field">
    <label for="<%= p %>-pet">Кличка тварини</label>
    <div class="control">
      <svg viewBox="0 0 24 24" class="control__ic icon icon--sm icon--fill" aria-hidden="true"><use href="#i-paw"/></svg>
      <input id="<%= p %>-pet" name="petName" type="text" maxlength="40"
             autocomplete="off" placeholder="Мурзик">
    </div>
  </div>

  <div class="field">
    <span class="field__label">Вік тварини</span>
    <div class="dropdown" data-dropdown data-placeholder="Оберіть вік">
      <input type="hidden" name="petAge" value="">
      <button class="dropdown__btn" type="button" aria-haspopup="listbox" aria-expanded="false">
        <span class="dropdown__value is-placeholder">Оберіть вік</span>
        <svg viewBox="0 0 24 24" class="icon icon--sm dropdown__chev" aria-hidden="true"><use href="#i-chev"/></svg>
      </button>
      <ul class="dropdown__list" role="listbox" tabindex="-1" aria-label="Вік тварини">
        <% petAgeOptions.forEach(function (o, i) { %>
          <li class="dropdown__opt" role="option" aria-selected="false"
              data-value="<%= o %>" style="--i: <%= i %>"><%= o %></li>
        <% }) %>
      </ul>
    </div>
  </div>

  <div class="field field--full">
    <span class="field__label">Послуга</span>
    <div class="dropdown" data-dropdown data-placeholder="Оберіть послугу">
      <input type="hidden" name="service" value="">
      <button class="dropdown__btn" type="button" aria-haspopup="listbox" aria-expanded="false">
        <span class="dropdown__value is-placeholder">Оберіть послугу</span>
        <svg viewBox="0 0 24 24" class="icon icon--sm dropdown__chev" aria-hidden="true"><use href="#i-chev"/></svg>
      </button>
      <ul class="dropdown__list" role="listbox" tabindex="-1" aria-label="Послуги">
        <% serviceOptions.forEach(function (o, i) { %>
          <li class="dropdown__opt" role="option" aria-selected="false"
              data-value="<%= o %>" style="--i: <%= i %>"><%= o %></li>
        <% }) %>
      </ul>
    </div>
  </div>

  <div class="field field--full">
    <span class="field__label">Бажаний час візиту</span>
    <div class="datepick" data-datepick data-hours='<%- JSON.stringify(scheduleByWeekday) %>'>
      <input type="hidden" name="preferredTime" value="">
      <button class="datepick__btn" type="button" aria-haspopup="dialog" aria-expanded="false">
        <svg viewBox="0 0 24 24" class="control__ic icon icon--sm" aria-hidden="true"><use href="#i-calendar"/></svg>
        <span class="datepick__value is-placeholder">Оберіть дату та час</span>
        <svg viewBox="0 0 24 24" class="icon icon--sm datepick__chev" aria-hidden="true"><use href="#i-chev"/></svg>
      </button>

      <div class="datepick__pop" role="dialog" aria-label="Вибір дати та часу">
        <div class="dp-cal">
          <div class="dp-head">
            <button class="dp-nav" type="button" data-dp-prev aria-label="Попередній місяць">
              <svg viewBox="0 0 24 24" class="icon icon--sm" aria-hidden="true"><use href="#i-chev"/></svg>
            </button>
            <b data-dp-month></b>
            <button class="dp-nav" type="button" data-dp-next aria-label="Наступний місяць">
              <svg viewBox="0 0 24 24" class="icon icon--sm" aria-hidden="true"><use href="#i-chev"/></svg>
            </button>
          </div>
          <div class="dp-week">
            <span>Пн</span><span>Вт</span><span>Ср</span><span>Чт</span><span>Пт</span><span>Сб</span><span>Нд</span>
          </div>
          <div class="dp-days" data-dp-days></div>
        </div>

        <div class="dp-times">
          <span class="dp-times__head" data-dp-label>Спершу оберіть день</span>
          <div class="dp-slots" data-dp-slots></div>
        </div>
      </div>
    </div>
  </div>

  <div class="field field--full">
    <label for="<%= p %>-msg">Що турбує?</label>
    <textarea id="<%= p %>-msg" name="message" rows="3"
              placeholder="Коротко опишіть симптоми або питання"></textarea>
  </div>

  <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">

  <label class="consent" for="<%= p %>-consent">
    <input id="<%= p %>-consent" class="consent__box" type="checkbox" name="consent" value="yes" required>
    <span class="consent__mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" class="icon icon--sm"><use href="#i-check"/></svg>
    </span>
    <span class="consent__text">
      Даю згоду на обробку персональних даних згідно з
      <a href="/privacy" target="_blank" rel="noopener">політикою конфіденційності</a>
    </span>
  </label>
  <small class="err err--consent" data-err="consent"></small>

  <button class="btn btn--primary btn--wide" type="submit">
    <svg viewBox="0 0 24 24" class="icon icon--fill" aria-hidden="true"><use href="#i-tg"/></svg>
    <span class="btn__label">Надіслати заявку</span>
  </button>

  <p class="form__status" role="status" aria-live="polite"></p>
</form>

<div class="form__done" hidden>
  <span class="form__done-ic"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#i-check"/></svg></span>
  <h3>Дякуємо, заявку прийнято!</h3>
  <p>Адміністратор передзвонить вам найближчим часом у робочі години.</p>
  <button class="btn btn--ghost btn--sm" type="button" data-reset>Надіслати ще одну</button>
</div>
