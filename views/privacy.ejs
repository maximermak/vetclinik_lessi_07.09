<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<% var L = t.legal; %>
<title><%= L.h1 %> — <%= fill(t.meta.siteName, { name: clinic.name }) %></title>
<meta name="description" content="<%= fill('{h1}: {intro}', { h1: L.h1, intro: L.intro.slice(0, 110) }) %>">
<meta name="robots" content="noindex, follow">
<link rel="canonical" href="<%= siteUrl + alt[lang] %>">
<% LANGS.forEach(function (l) { %>
<link rel="alternate" hreflang="<%= l %>" href="<%= siteUrl + alt[l] %>">
<% }) %>
<meta name="theme-color" content="#15705c">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<link rel="preload" href="/fonts/manrope-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/style.css?v=<%= v('/css/style.css') %>">
<%- include('partials/analytics') %>
</head>
<body>
<a class="skip" href="#main"><%= t.skip %></a>
<span id="top" aria-hidden="true"></span>
<%- include('partials/icons') %>
<%- include('partials/header') %>

<%
  var phoneHtml = '<a href="tel:' + clinic.phones[0].raw + '">' + clinic.phones[0].pretty + '</a>';
  var mailHtml = '<a href="mailto:' + clinic.legal.email + '">' + clinic.legal.email + '</a>';
  var lv = {
    name: clinic.name,
    entity: clinic.legal.entity,
    code: clinic.legal.code ? (', ' + L.codeLabel + ' ' + clinic.legal.code) : '',
    address: clinic.addressFull,
    phone: phoneHtml,
    email: mailHtml,
    updated: clinic.legal.updated
  };
%>

<main id="main" tabindex="-1" class="legal">
  <div class="container container--narrow">
    <header class="legal__head">
      <span class="eyebrow"><%= L.eyebrow %></span>
      <h1><%= L.h1 %></h1>
      <p class="legal__meta"><%= fill(L.meta, lv) %></p>
    </header>

    <div class="legal__body">
      <p><%- fill(L.intro, lv) %></p>

      <% L.sections.forEach(function (sec) { %>
        <h2><%= sec.h %></h2>
        <% sec.blocks.forEach(function (b) { %>
          <% if (b.ul) { %>
            <ul class="legal__list">
              <% b.ul.forEach(function (li) { %><li><%- fill(li, lv) %></li><% }) %>
            </ul>
          <% } else { %>
            <p><%- fill(b.p, lv) %></p>
          <% } %>
        <% }) %>
      <% }) %>
    </div>

    <div class="legal__back">
      <a class="btn btn--primary" href="<%= path(lang, '/') %>"><%= L.back %></a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
<script src="/js/app.js?v=<%= v('/js/app.js') %>" defer></script>
</body>
</html>
